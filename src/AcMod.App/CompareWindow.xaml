<Window x:Class="AcMod.App.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare data files" Width="1000" Height="640">
    <DockPanel Margin="8">
        <!-- A Grid places controls in rows and columns: row 0 is the left side, row 1 the right side. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Text="Left" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,4" />
            <ComboBox x:Name="LeftCar" Grid.Row="0" Grid.Column="1" Margin="0,0,8,4" SelectionChanged="LeftCar_SelectionChanged" />
            <ComboBox x:Name="LeftVersion" Grid.Row="0" Grid.Column="2" Margin="0,0,8,4" />

            <TextBlock Text="Right" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="RightCar" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" SelectionChanged="RightCar_SelectionChanged" />
            <ComboBox x:Name="RightVersion" Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" />

            <Button Content="Compare" Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Padding="16,4" Click="Compare_Click" />
        </Grid>

        <TextBlock x:Name="Summary" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />

        <DataGrid x:Name="DiffGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding File}" />
                <DataGridTextColumn Header="Field" Binding="{Binding Field}" FontFamily="Consolas" />
                <DataGridTextColumn Header="Left" Binding="{Binding Left}" FontFamily="Consolas" />
                <DataGridTextColumn Header="Right" Binding="{Binding Right}" FontFamily="Consolas" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
