<Window x:Class="AcMod.App.SaveAsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save as new car" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12">
        <TextBlock x:Name="Intro" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Text="New car ID (lowercase letters, digits and _)" />
        <TextBox x:Name="NewIdBox" Margin="0,2,0,8" />
        <TextBlock Text="Display name" />
        <TextBox x:Name="NameBox" Margin="0,2,0,8" />
        <CheckBox x:Name="ReplaceBox" Content="Replace previous: move the old car to the trash if the new one validates without errors" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save as new car" IsDefault="True" Click="Ok_Click" Padding="12,4" />
            <Button Content="Cancel" IsCancel="True" Padding="12,4" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
