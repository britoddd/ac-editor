<Window x:Class="AcMod.App.NewCarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New car" Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="A new car starts empty: folders and a name only. The first-car checklist then walks you through the model, collider, data and sound." />
        <TextBlock Text="Car ID (lowercase letters, digits and _)" />
        <TextBox x:Name="IdBox" Margin="0,2,0,8" />
        <TextBlock Text="Display name" />
        <TextBox x:Name="NameBox" Margin="0,2,0,8" />
        <CheckBox x:Name="CompleteBox" Content="Start from a complete car instead (copies everything; the checklist marks the copied model and collider)" Margin="0,0,0,4" />
        <ComboBox x:Name="SourceBox" IsEnabled="{Binding IsChecked, ElementName=CompleteBox}" Margin="18,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Create" IsDefault="True" Click="Ok_Click" Padding="12,4" />
            <Button Content="Cancel" IsCancel="True" Padding="12,4" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
