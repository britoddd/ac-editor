<Window x:Class="AcMod.App.SnapshotsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="440" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Every save takes a snapshot of the car's data and UI files first. Restore puts a snapshot back; it takes a snapshot of the current files first, so it can be undone too." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Take a snapshot now" Click="Take_Click" Padding="12,4" />
            <Button Content="Compare..." Click="Compare_Click" Padding="12,4" Margin="8,0,0,0" />
            <Button Content="Restore" Click="Restore_Click" Padding="12,4" Margin="8,0,0,0" />
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <ListBox x:Name="SnapshotList" DisplayMemberPath="Label" FontFamily="Consolas" />
    </DockPanel>
</Window>
