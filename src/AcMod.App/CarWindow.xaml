<Window x:Class="AcMod.App.CarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1100" Height="700" Closing="Window_Closing">
    <DockPanel Margin="8">
        <TextBlock x:Name="Header" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="SaveButton" Content="Save..." Click="Save_Click" Padding="12,4" />
            <Button x:Name="DiscardButton" Content="Discard changes" Click="Discard_Click" Padding="12,4" Margin="8,0,0,0" />
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <!-- DisplayMemberPath shows each FileRow's Label; a * marks a file with unsaved changes (TU-7). -->
        <ListBox x:Name="FileList" DockPanel.Dock="Left" Width="260" DisplayMemberPath="Label"
                 FontFamily="Consolas" SelectionChanged="FileList_SelectionChanged" />

        <TextBox x:Name="Editor" Margin="8,0,0,0" FontFamily="Consolas" FontSize="13"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 TextChanged="Editor_TextChanged" />
    </DockPanel>
</Window>
