<Window x:Class="AcMod.App.CarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1100" Height="700" Closing="Window_Closing">
    <DockPanel Margin="8">
        <TextBlock x:Name="Header" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="SaveButton" Content="Save..." Click="Save_Click" Padding="12,4" />
            <Button x:Name="DiscardButton" Content="Discard changes" Click="Discard_Click" Padding="12,4" Margin="8,0,0,0" />
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <!-- All tabs share one edit session, so a change on any tab gets the same * and the same Save preview. -->
        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <TabItem x:Name="FormsTab" Header="Forms">
                <DockPanel Margin="0,8,0,0">
                    <ListBox x:Name="GroupList" DockPanel.Dock="Left" Width="150" SelectionChanged="GroupList_SelectionChanged" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,8">
                        <TextBlock Text="Section" VerticalAlignment="Center" />
                        <ComboBox x:Name="SectionBox" Width="260" Margin="8,0,0,0" SelectionChanged="SectionBox_SelectionChanged" />
                        <TextBlock x:Name="FormNote" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <!-- * marks a value that differs from the saved file. Only the Value column is editable. -->
                    <DataGrid x:Name="FormGrid" Margin="8,0,0,0" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding Mark}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Field" Binding="{Binding Key}" IsReadOnly="True" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Hint (from the file's own comments)" Binding="{Binding Hint}" IsReadOnly="True" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="PowerTab" Header="Power curve">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock x:Name="PowerSummary" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <DockPanel DockPanel.Dock="Left" Width="360">
                        <!-- TU-8: change every selected row at once (select with Ctrl or Shift click). -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Selected rows:" VerticalAlignment="Center" />
                            <TextBox x:Name="AmountBox" Width="60" Margin="6,0,0,0" Text="5" />
                            <Button Content="Scale %" Click="Scale_Click" Padding="8,2" Margin="6,0,0,0" />
                            <Button Content="Add Nm" Click="Add_Click" Padding="8,2" Margin="6,0,0,0" />
                        </StackPanel>
                        <!-- Only the Torque column is editable. Adding or removing rows is done on the Raw files tab. -->
                        <DataGrid x:Name="PowerGrid" AutoGenerateColumns="False" SelectionMode="Extended" SelectionChanged="PowerGrid_SelectionChanged"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" FontFamily="Consolas">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="rpm" Binding="{Binding Rpm}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Torque (power.lut)" Binding="{Binding Torque}" />
                                <DataGridTextColumn Header="Power (hp)" Binding="{Binding Power}" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <Border BorderBrush="Gray" BorderThickness="1" Margin="8,0,0,0">
                        <Canvas x:Name="Chart" ClipToBounds="True" Background="White" SizeChanged="Chart_SizeChanged"
                                MouseLeftButtonDown="Chart_MouseLeftButtonDown" MouseMove="Chart_MouseMove" MouseLeftButtonUp="Chart_MouseLeftButtonUp" LostMouseCapture="Chart_LostMouseCapture" />
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="GearsTab" Header="Gears">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock x:Name="GearSummary" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <!-- Read-only: the speeds follow LIMITER, the gear ratios, FINAL and the tyre radius, wherever they are edited. -->
                    <DataGrid x:Name="GearGrid" HorizontalAlignment="Left" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="False" FontFamily="Consolas">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Gear" Binding="{Binding Gear}" />
                            <DataGridTextColumn Header="Ratio" Binding="{Binding Ratio}" />
                            <DataGridTextColumn x:Name="FrontColumn" Binding="{Binding Front}" />
                            <DataGridTextColumn x:Name="RearColumn" Binding="{Binding Rear}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="RawTab" Header="Raw files">
                <DockPanel Margin="0,8,0,0">
                    <!-- DisplayMemberPath shows each FileRow's Label; a * marks a file with unsaved changes (TU-7). -->
                    <ListBox x:Name="FileList" DockPanel.Dock="Left" Width="260" DisplayMemberPath="Label"
                             FontFamily="Consolas" SelectionChanged="FileList_SelectionChanged" />
                    <TextBox x:Name="Editor" Margin="8,0,0,0" FontFamily="Consolas" FontSize="13"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             TextChanged="Editor_TextChanged" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
