<Window x:Class="AcMod.App.PickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="480" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock x:Name="Prompt" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Use this one" IsDefault="True" Click="Ok_Click" Padding="12,4" />
            <Button Content="Cancel" IsCancel="True" Padding="12,4" Margin="8,0,0,0" />
        </StackPanel>
        <ListBox x:Name="Choices" DisplayMemberPath="Label" MouseDoubleClick="Ok_Click" />
    </DockPanel>
</Window>
