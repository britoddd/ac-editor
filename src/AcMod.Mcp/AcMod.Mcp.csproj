<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>acmod-mcp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- CC-2: the stdio MCP server. The package is named in CLAUDE.md's stack. -->
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <!-- The SDK's documented stdio setup (its QuickstartWeatherServer sample) runs inside the .NET generic host. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AcMod.Core\AcMod.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AcMod.Core.Tests" />
  </ItemGroup>

</Project>
