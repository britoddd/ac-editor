{
  "permissions": {
    "allow": [
      "mcp__acmod__list_cars",
      "mcp__acmod__read_car",
      "mcp__acmod__validate",
      "mcp__acmod__gears",
      "mcp__acmod__list_snapshots",
      "mcp__acmod__compare_snapshots",
      "mcp__acmod__read_ac_log"
    ],
    "deny": [
      "Edit(//d/ACModding/cars/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-cars.ps1"]
          }
        ]
      }
    ]
  }
}
